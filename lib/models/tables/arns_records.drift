-- The records of the names in ant_records, as ArNS has them.
CREATE TABLE arns_records (
    -- The literal name, e.g. blog_ardrive, or ardrive for '@'.
    id TEXT NOT NULL PRIMARY KEY,
    domain TEXT NOT NULL,
    -- The undername, '@' for the name itself.
    name TEXT NOT NULL,
    transaction_id TEXT NOT NULL,
    ttl INTEGER NOT NULL
);
