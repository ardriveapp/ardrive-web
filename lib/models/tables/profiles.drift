CREATE TABLE profiles (
    id TEXT NOT NULL PRIMARY KEY,

    username TEXT NOT NULL,

    encryptedWallet BLOB NOT NULL,
    keySalt BLOB NOT NULL,
    walletPublicKey TEXT NOT NULL,
    encryptedPublicKey BLOB NOT NULL,
    profileType INTEGER NOT NULL,
    sourceWalletAddress TEXT,

    -- 1: the wallet and public key are encrypted under the password's key
    -- with keySalt as the nonce, the format before 3.0. 2: each is sealed
    -- with its own random nonce under the device key. See ProfileDao.
    formatVersion INTEGER NOT NULL DEFAULT 1,
    -- Format 2: random bytes that, with the unlock secret, derive the
    -- device key (DeviceUnlockMethod).
    deviceSalt BLOB,
    unlockMethod TEXT,
    -- Format 2: a known plaintext sealed under the device key.
    keyCheck BLOB
);
